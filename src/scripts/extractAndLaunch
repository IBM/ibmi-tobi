#!/usr/bin/env bash
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

joblog_json=$1
pseudoSrcFile=$2
#Escapes \# back to #
pseudoSrcFile="${pseudoSrcFile//\\#/#}"
#Escapes DOLLARESCAPE_ back to $
pseudoSrcFile="${pseudoSrcFile//DOLLARESCAPE_/$}"
objlib=$3
objname=$4
#Escapes DOLLARESCAPE_ back to $ in objname
objname="${objname//DOLLARESCAPE_/$}"
precmd=$5
postcmd=$6
object=$7
source=$8
output=$9
cmd=""
suppressError=""

# Identify types (DTAARA, DTAQ, MSGF) by target extension.
obj_ext="${object##*.}"
obj_ext="${obj_ext^^}"
case "$obj_ext" in
  (DTAARA|DTAQ|MSGF) obj_ibmi_type="*$obj_ext" ;;
  *) obj_ibmi_type="" ;;
esac
iasp_prefix="${iasp:+/$iasp}"

# On rebuild, backup the existing object and delete it before recreating.
obj_backed_up=""
if [ -n "$obj_ibmi_type" ] && [ -e "${iasp_prefix}/QSYS.LIB/$objlib.LIB/$objname.$obj_ext" ]; then
  cl "CRTSAVF FILE(QTEMP/$objlib)"
  cl "SAVOBJ OBJ($objname) LIB($objlib) DEV(*SAVF) OBJTYPE($obj_ibmi_type) SAVF(QTEMP/$objlib)"
  cl "DLTOBJ OBJ($objlib/$objname) OBJTYPE($obj_ibmi_type)"
  obj_backed_up="Y"
fi

while read -r line; do
  line=$(echo "$line" | sed 's/\r//')
  # if a line begins with ! then suppress errors and continue
  if [[ $line =~ \!.* ]]; then
    line=$(echo "$line" | sed 's/^\!//')
    suppressError="Y"
  fi
  if [[ $line = '/*'* ]]; then continue; fi
  if [[ $line = '' ]]; then continue; fi
  if [[ $line =~ .*\+\S*$ ]]; then
    linetmp=$(echo "$line" | sed 's/\+\S*$//')
    cmd="${cmd} ${linetmp}"
    continue
  fi

  cmd+=$line
  if [ -n "$cmd" ]; then
    cmd=$(echo "$cmd" | sed "s/&O/$objlib/g" | sed "s/&N/$objname/g")
    "$SCRIPT_DIR"/launch "$joblog_json" "$cmd" "$precmd" "$postcmd" "$object" "$source" "$output" </dev/null
    if [[ $? -ne 0 && "$suppressError" != "Y" ]]; then
      echo "Command failed: $cmd"
      if [ "$obj_backed_up" = "Y" ]; then
        echo "Restoring previous $objlib/$objname..."
        cl "RSTOBJ OBJ($objname) SAVLIB($objlib) DEV(*SAVF) OBJTYPE($obj_ibmi_type) SAVF(QTEMP/$objlib)"
      fi
      exit 1
    fi
    suppressError=""
    cmd=""
  fi
done < <(grep "" "$pseudoSrcFile")
