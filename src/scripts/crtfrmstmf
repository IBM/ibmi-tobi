#!/usr/bin/env bash

SCRIPT_DIR="$(dirname "$0")"
TOBI_DIR=$(realpath "${SCRIPT_DIR}/../..")
IFS=$'\\n'
echo "$IBMiEnvCmd"
if [ ! -z "$IBMiEnvCmd" ] && echo "$IBMiEnvCmd" | grep -qi "SETASPGRP"; then
  for envcmd in $IBMiEnvCmd; do
    [[ ! -z "$envcmd" ]] && cl "$envcmd"
  done
fi

# Single pass: detect -c CRTOVL and build a filtered arg list (strips -c and --ccsid pairs).
PYTHON_MODULE="crtfrmstmf"
filtered=()
skip_next=false
for arg in "$@"; do
  # Detect CRTOVL *before* the skip so the value is seen even when -c is being stripped.
  if [ "$_prev" = "-c" ] && [ "$(echo "$arg" | tr '[:lower:]' '[:upper:]')" = "CRTOVL" ]; then
    PYTHON_MODULE="crtovl"
  fi
  if $skip_next; then
    skip_next=false
    _prev="$arg"
    continue
  fi
  case "$arg" in
    -c|--ccsid) skip_next=true ;;
    *) filtered+=("$arg") ;;
  esac
  _prev="$arg"
done

if [ "$PYTHON_MODULE" = "crtovl" ]; then
  pass_args=("${filtered[@]}")
else
  pass_args=("$@")
fi
PYTHONPATH="${TOBI_DIR}/src":${PYTHONPATH} /QOpenSys/pkgs/bin/python3.9 \
  "${TOBI_DIR}/src/makei/${PYTHON_MODULE}.py" "${pass_args[@]}"
